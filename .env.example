# Environment variables for PostgreSQL & Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/coop_gig_db?schema=public"

# Supabase Auth & Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
