// ============================================================================
// Cooperative Gig Services Platform - Production Database Schema
// Database Engine: PostgreSQL 14+ | ORM: Prisma
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  WORKER
  COOP_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  PAID_OUT
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  UPI
  DIGITAL_WALLET
  COOP_CREDITS
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CUSTOMER_FAVOR
  RESOLVED_WORKER_FAVOR
  SPLIT_RESOLUTION
  DISMISSED
}

enum WalletType {
  WORKER_WALLET
  COOP_ADMIN_FUND
  WORKER_WELFARE_INSURANCE_FUND
}

// ----------------------------------------------------------------------------
// COOPERATIVE ENTITY
// ----------------------------------------------------------------------------

/// Represents the cooperative federation or local autonomous chapter.
/// Workers are member-owners of the cooperative.
model Cooperative {
  id                 String          @id @default(uuid())
  name               String          @unique
  registrationNumber String          @unique
  contactEmail       String
  contactPhone       String?
  address            String?
  
  // Financial & Split Configurations
  defaultCoopSplitRatio   Decimal    @default(0.0800) @db.Decimal(5, 4) // e.g. 8.00% cooperative operating & dividend pool
  defaultWorkerSplitRatio Decimal    @default(0.9200) @db.Decimal(5, 4) // e.g. 92.00% retained by worker-member
  dividendPoolBalance     Decimal    @default(0.00)   @db.Decimal(12, 2)
  currency                String     @default("USD")
  
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relationships
  admins             User[]          @relation("CoopAdmins")
  workerProfiles     WorkerProfile[]
  payments           Payment[]
  wallets            Wallet[]

  @@index([isActive])
}

// ----------------------------------------------------------------------------
// USER IDENTITY & AUTH
// ----------------------------------------------------------------------------

/// Base user model encompassing Customers, Workers, and Cooperative Admins.
model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  phone              String?         @unique
  passwordHash       String
  firstName          String
  lastName           String
  avatarUrl          String?
  role               UserRole        @default(CUSTOMER)
  status             UserStatus      @default(ACTIVE)

  // Cooperative membership link (primarily for Workers and Coop Admins)
  cooperativeId      String?
  cooperative        Cooperative?    @relation("CoopAdmins", fields: [cooperativeId], references: [id], onDelete: SetNull)
  isCoopMember       Boolean         @default(false)
  membershipJoinedAt DateTime?

  // Profile Relations
  workerProfile      WorkerProfile?

  // Operational Relations
  customerBookings   Booking[]       @relation("CustomerBookings")
  reviewsAuthored    Review[]        @relation("AuthoredReviews")
  disputesRaised     BookingDispute[] @relation("DisputesRaisedByUser")
  wallets            Wallet[]

  // Audit Timestamps
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([role, status])
  @@index([email])
  @@index([phone])
}

// ----------------------------------------------------------------------------
// WORKER PROFILE & CREDENTIALING
// ----------------------------------------------------------------------------

/// Extended profile for worker-members of the cooperative.
model WorkerProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cooperative Affiliation
  cooperativeId        String?
  cooperative          Cooperative?       @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)

  // Verification & Compliance
  verificationStatus   VerificationStatus @default(PENDING)
  verificationNotes    String?            @db.Text
  verifiedAt           DateTime?
  nationalIdMasked     String?
  backgroundChecked    Boolean            @default(false)
  backgroundCheckedAt  DateTime?

  // Professional Bio & Metrics
  bio                  String?            @db.Text
  experienceYears      Int?               @default(0)
  hourlyRate           Decimal?           @db.Decimal(10, 2)
  isAvailable          Boolean            @default(true)

  // Aggregated Reputation (maintained via triggers or transaction hooks)
  averageRating        Decimal            @default(0.00) @db.Decimal(3, 2)
  totalReviews         Int                @default(0)
  completedJobsCount   Int                @default(0)

  // Geospatial Information for Dispatching & Discovery
  latitude             Float?
  longitude            Float?
  serviceRadiusKm      Float              @default(15.0)
  serviceCity          String?
  servicePostalCode    String?

  // Relations
  services             WorkerService[]
  certifications       Certification[]
  bookings             Booking[]          @relation("WorkerBookings")
  reviewsReceived      Review[]           @relation("WorkerReceivedReviews")

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Composite indexes for quick geo-radius and availability queries
  @@index([latitude, longitude])
  @@index([verificationStatus, isAvailable])
  @@index([averageRating(sort: Desc)])
  @@index([cooperativeId])
}

// ----------------------------------------------------------------------------
// SERVICE CATALOGUE & SKILLS
// ----------------------------------------------------------------------------

/// Hierarchical catalogue of service categories offered through the cooperative.
model ServiceCategory {
  id                 String            @id @default(uuid())
  name               String            @unique
  slug               String            @unique
  description        String?           @db.Text
  iconUrl            String?
  basePrice          Decimal?          @db.Decimal(10, 2)
  isActive           Boolean           @default(true)

  // Self-referencing hierarchy (e.g. Home Maintenance -> Plumbing -> Pipe Leak Repair)
  parentId           String?
  parent             ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           ServiceCategory[] @relation("CategoryHierarchy")

  // Relations
  workerServices     WorkerService[]
  bookings           Booking[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

/// Explicit Many-to-Many join model between WorkerProfile and ServiceCategory.
/// Allows per-category pricing, custom skill tier, and custom experience.
model WorkerService {
  id                String          @id @default(uuid())
  workerProfileId   String
  workerProfile     WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)

  customHourlyRate  Decimal?        @db.Decimal(10, 2)
  isCertified       Boolean         @default(false)
  isActive          Boolean         @default(true)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workerProfileId, serviceCategoryId])
  @@index([serviceCategoryId, isActive])
  @@index([workerProfileId, isActive])
}

/// Professional certifications, licenses, and verified trade diplomas.
model Certification {
  id                 String             @id @default(uuid())
  workerProfileId    String
  workerProfile      WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  title              String
  issuingAuthority   String
  licenseNumber      String?
  documentUrl        String?
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([workerProfileId])
  @@index([verificationStatus])
}

// ----------------------------------------------------------------------------
// BOOKINGS
// ----------------------------------------------------------------------------

/// Represents a customer service engagement with a cooperative worker-member.
model Booking {
  id                     String          @id @default(uuid())
  bookingNumber          String          @unique // Human-friendly reference: e.g. "BKG-2026-0001"

  // Parties involved
  customerId             String
  customer               User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  
  workerId               String
  worker                 WorkerProfile   @relation("WorkerBookings", fields: [workerId], references: [id], onDelete: Restrict)

  serviceCategoryId      String
  serviceCategory        ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)

  // Scheduling & Lifecycle
  status                 BookingStatus   @default(PENDING)
  scheduledDate          DateTime
  estimatedDurationHours Decimal?        @db.Decimal(4, 2)
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?         @db.Text

  // Service Location (with coordinates for dispatch tracking)
  serviceAddressLine1    String
  serviceAddressLine2    String?
  serviceCity            String
  servicePostalCode      String
  serviceLatitude        Float
  serviceLongitude       Float
  locationInstructions   String?         @db.Text

  // Financial Summary
  totalAmount            Decimal         @db.Decimal(10, 2)
  currency               String          @default("USD")

  // Relations
  payment                Payment?
  review                 Review?
  disputes               BookingDispute[]

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Highly optimized composite indexes for dashboard and scheduling queries
  @@index([customerId, status])
  @@index([workerId, status])
  @@index([workerId, scheduledDate])
  @@index([status, scheduledDate])
  @@index([serviceCategoryId, status])
  @@index([serviceLatitude, serviceLongitude])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// PAYMENTS & COOPERATIVE SPLIT ACCOUNTING
// ----------------------------------------------------------------------------

/// Handles payments with cooperative patronage & operating dividend split tracking.
model Payment {
  id                   String          @id @default(uuid())
  transactionId        String          @unique // External payment gateway reference (e.g. Stripe pi_...)
  
  bookingId            String          @unique
  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  cooperativeId        String?
  cooperative          Cooperative?    @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)

  // Financial Breakdown & Split Ratio
  totalAmount          Decimal         @db.Decimal(10, 2)
  workerAmount         Decimal         @db.Decimal(10, 2) // 80% paid to worker_wallet
  coopAmount           Decimal         @db.Decimal(10, 2) // 15% to cooperative_admin_fund
  welfareAmount        Decimal         @default(0.00) @db.Decimal(10, 2) // 5% to worker_welfare_insurance_fund
  workerSplitRatio     Decimal         @default(0.8000) @db.Decimal(5, 4)  // e.g. 0.8000 (80.00%)
  coopSplitRatio       Decimal         @default(0.1500) @db.Decimal(5, 4)  // e.g. 0.1500 (15.00%)
  welfareSplitRatio    Decimal         @default(0.0500) @db.Decimal(5, 4)  // e.g. 0.0500 (5.00%)
  gatewayFeeAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  currency             String          @default("INR")

  // Payment State & Method
  paymentMethod        PaymentMethod   @default(UPI)
  status               PaymentStatus   @default(PENDING)
  
  // Escrow & Settlement Milestones
  escrowReleasedAt     DateTime?
  workerPaidOutAt      DateTime?
  refundedAt           DateTime?
  
  // Audit Trail
  gatewayRawResponse   Json?
  failureReason        String?         @db.Text
  ledgerEntries        WalletLedger[]

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([cooperativeId, status])
  @@index([transactionId])
}

// ----------------------------------------------------------------------------
// WALLETS & WELFARE FUNDS
// ----------------------------------------------------------------------------

/// Digital wallets for Worker Members, Cooperative Treasury, and Welfare Funds.
model Wallet {
  id            String         @id @default(uuid())
  type          WalletType
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  cooperativeId String?
  cooperative   Cooperative?   @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)
  balance       Decimal        @default(0.00) @db.Decimal(12, 2)
  currency      String         @default("INR")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ledgerEntries WalletLedger[]

  @@unique([userId, type])
  @@index([type])
  @@index([cooperativeId])
}

/// Double-entry ledger audit trail for all wallet transactions.
model WalletLedger {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(12, 2)
  entryType   String   // "CREDIT" or "DEBIT"
  description String
  createdAt   DateTime @default(now())

  @@index([walletId])
  @@index([paymentId])
}


// ----------------------------------------------------------------------------
// REPUTATION & REVIEWS
// ----------------------------------------------------------------------------

/// Verified reviews tied strictly to completed bookings (1-to-1 relation).
model Review {
  id                   String          @id @default(uuid())
  
  bookingId            String          @unique // Guarantees exactly 1 review per booking
  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  customerId           String
  customer             User            @relation("AuthoredReviews", fields: [customerId], references: [id], onDelete: Restrict)

  workerId             String
  worker               WorkerProfile   @relation("WorkerReceivedReviews", fields: [workerId], references: [id], onDelete: Restrict)

  // Numerical Evaluation (1 to 5)
  rating               Int             // Validated 1-5 via app layer or DB CHECK constraint
  punctualityRating    Int?            // Sub-dimension: 1 to 5
  qualityRating        Int?            // Sub-dimension: 1 to 5
  valueRating          Int?            // Sub-dimension: 1 to 5

  comment              String?         @db.Text

  // Worker Response (Right of reply for transparency)
  workerReply          String?         @db.Text
  workerRepliedAt      DateTime?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([workerId, rating])
  @@index([customerId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// DISPUTE RESOLUTION (COOPERATIVE GOVERNANCE)
// ----------------------------------------------------------------------------

/// Transparent conflict resolution managed democratically by Cooperative Admins.
model BookingDispute {
  id                   String          @id @default(uuid())
  bookingId            String
  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  raisedById           String
  raisedBy             User            @relation("DisputesRaisedByUser", fields: [raisedById], references: [id], onDelete: Restrict)

  reason               String
  description          String          @db.Text
  status               DisputeStatus   @default(OPEN)
  resolutionNotes      String?         @db.Text
  resolvedAt           DateTime?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([bookingId])
  @@index([status])
}
