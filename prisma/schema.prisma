// ============================================================================
// Cooperative Gig Services Platform - Production Database Schema
// Database Engine: PostgreSQL 14+ with PostGIS | ORM: Prisma
// SyncBridge — SIH PS ID 26089 — Ministry of Cooperation / NCCT
// Split: 90% Worker | 5% Society Reserve | 5% Welfare Trust
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  WORKER
  SOCIETY_SECRETARY   // Primary Labour Cooperative Secretary
  FEDERATION_ADMIN    // State / National Federation Admin
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum BookingType {
  INSTANT     // Same-day booking
  SCHEDULED   // Future date; may have recurrence_rule
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  PAID_OUT
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  UPI
  DIGITAL_WALLET
  COOP_CREDITS
}

enum DisputeStatus {
  OPEN
  PEER_REVIEW        // Assigned to peer council — under deliberation
  RESOLVED_UPHELD    // Complaint upheld; remediation applied
  RESOLVED_OVERTURNED // Complaint overturned; worker standing restored
  DISMISSED
  CLOSED
}

enum DisputeVoteDecision {
  UPHOLD    // Vote to uphold complaint
  OVERTURN  // Vote to restore worker standing
  ABSTAIN
}

enum WalletType {
  WORKER_WALLET
  SOCIETY_RESERVE         // 5% cooperative society fund
  WELFARE_TRUST           // 5% mutual insurance / welfare fund
  GUARANTEE_FUND          // 1% escrow / protection reserve
}

enum ToolCondition {
  EXCELLENT
  GOOD
  FAIR
  UNDER_MAINTENANCE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// ----------------------------------------------------------------------------
// FEDERATION & COOPERATIVE ENTITIES
// ----------------------------------------------------------------------------

/// State / National-level Cooperative Federation (multi-tenant root)
model Federation {
  id                 String        @id @default(uuid())
  name               String        @unique
  registrationNumber String        @unique
  stateCode          String        // e.g. "KA", "MH", "TN"
  contactEmail       String
  contactPhone       String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  societies          Society[]
  admins             User[]        @relation("FederationAdmins")

  @@index([stateCode])
}

/// Primary Labour Cooperative Society (44,000+ across India)
/// Each Society belongs to a Federation; workers are member-owners of a Society.
model Society {
  id                 String        @id @default(uuid())
  name               String
  ncdCode            String        @unique  // National Cooperative Database code
  registrationNumber String        @unique
  contactEmail       String
  contactPhone       String?
  address            String?
  city               String?
  stateCode          String?

  federationId       String
  federation         Federation    @relation(fields: [federationId], references: [id], onDelete: Restrict)

  // 90/5/5 Split Configuration (overridable per society)
  workerSplitRatio   Decimal       @default(0.9000) @db.Decimal(5, 4)  // 90%
  societySplitRatio  Decimal       @default(0.0500) @db.Decimal(5, 4)  // 5%
  welfareSplitRatio  Decimal       @default(0.0500) @db.Decimal(5, 4)  // 5%
  serviceRadiusKm    Float         @default(5.0)   // Default 5km geofence

  dividendPoolBalance Decimal      @default(0.00)  @db.Decimal(14, 2)
  currency            String       @default("INR")
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  secretaries        User[]        @relation("SocietySecretaries")
  workers            WorkerProfile[]
  wallets            Wallet[]
  payments           Payment[]
  demandSnapshots    DemandSnapshot[]

  @@index([federationId])
  @@index([ncdCode])
  @@index([isActive])
}

// ----------------------------------------------------------------------------
// USER IDENTITY & AUTH
// ----------------------------------------------------------------------------

/// Base user model encompassing Customers, Workers, Secretaries, and Admins.
model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  phone              String?         @unique
  passwordHash       String?
  firstName          String
  lastName           String
  avatarUrl          String?
  role               UserRole        @default(CUSTOMER)
  status             UserStatus      @default(ACTIVE)
  preferredLanguage  String          @default("en")  // ISO 639-1

  // Cooperative membership
  societyId          String?
  society            Society?        @relation("SocietySecretaries", fields: [societyId], references: [id], onDelete: SetNull)
  federationId       String?
  federation         Federation?     @relation("FederationAdmins", fields: [federationId], references: [id], onDelete: SetNull)
  isCoopMember       Boolean         @default(false)
  membershipJoinedAt DateTime?

  // Relations
  workerProfile      WorkerProfile?
  customerBookings   Booking[]       @relation("CustomerBookings")
  reviewsAuthored    Review[]        @relation("AuthoredReviews")
  disputesRaised     Dispute[]       @relation("DisputesRaisedByUser")
  councilVotes       PeerCouncilVote[]
  wallets            Wallet[]

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([role, status])
  @@index([email])
  @@index([phone])
  @@index([societyId])
}

// ----------------------------------------------------------------------------
// WORKER PROFILE & CREDENTIALING
// ----------------------------------------------------------------------------

/// Extended profile for worker-members of the cooperative.
model WorkerProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  societyId            String?
  society              Society?           @relation(fields: [societyId], references: [id], onDelete: SetNull)

  // e-Shram / NCD Identifiers
  eShramUan            String?            @unique  // Unorganised Aadhaar Number
  ncdSocietyCode       String?
  aadhaarMasked        String?            // Last 4 digits only

  // Verification Status (aggregate)
  verificationStatus   VerificationStatus @default(PENDING)
  verificationNotes    String?            @db.Text
  verifiedAt           DateTime?
  backgroundChecked    Boolean            @default(false)
  backgroundCheckedAt  DateTime?

  // Professional Bio & Metrics
  bio                  String?            @db.Text
  experienceYears      Int?               @default(0)
  hourlyRate           Decimal?           @db.Decimal(10, 2)
  isAvailable          Boolean            @default(true)

  // Aggregated Reputation (updated via payment completion hooks)
  averageRating        Decimal            @default(0.00) @db.Decimal(3, 2)
  totalReviews         Int                @default(0)
  completedJobsCount   Int                @default(0)

  // Geospatial — lat/lng for Prisma queries; raw PostGIS point via migrations
  latitude             Float?
  longitude            Float?
  serviceRadiusKm      Float              @default(5.0)
  serviceCity          String?
  servicePostalCode    String?

  // Relations
  services             WorkerService[]
  certifications       Certification[]
  verifications        WorkerVerification[]
  availabilityWindows  AvailabilityWindow[]
  bookings             Booking[]          @relation("WorkerBookings")
  reviewsReceived      Review[]           @relation("WorkerReceivedReviews")
  toolCheckouts        ToolCheckout[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([latitude, longitude])
  @@index([verificationStatus, isAvailable])
  @@index([averageRating(sort: Desc)])
  @@index([societyId])
}

// ----------------------------------------------------------------------------
// VERIFICATION RECORDS (separate from WorkerProfile aggregate status)
// ----------------------------------------------------------------------------

/// Individual verification check records — source of truth for badges.
/// Changing a row here changes the badge without a code deploy.
model WorkerVerification {
  id              String             @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  verificationType String            // "AADHAAR_EKYC" | "ESHRAM_UAN" | "NCD_REGISTRY" | "POLICE_CLEARANCE" | "NCCT_CERT"
  status          VerificationStatus @default(PENDING)
  referenceId     String?            // External reference (e.g. UAN, cert number)
  verifiedAt      DateTime?
  expiresAt       DateTime?
  provider        String             @default("MOCK")  // "MOCK" | "UIDAI" | "ESHRAM" | "NCD" | "POLICE"
  rawResponseHash String?            // SHA-256 of provider response for audit trail
  notes           String?            @db.Text

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([workerProfileId, verificationType])
  @@index([workerProfileId])
  @@index([status])
  @@index([expiresAt])
}

// ----------------------------------------------------------------------------
// SERVICE CATALOGUE & SKILLS
// ----------------------------------------------------------------------------

model ServiceCategory {
  id                 String            @id @default(uuid())
  name               String            @unique
  slug               String            @unique
  description        String?           @db.Text
  iconUrl            String?
  basePrice          Decimal?          @db.Decimal(10, 2)
  isActive           Boolean           @default(true)
  isEmergencyEligible Boolean          @default(false)

  parentId           String?
  parent             ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           ServiceCategory[] @relation("CategoryHierarchy")

  workerServices     WorkerService[]
  bookings           Booking[]
  demandSnapshots    DemandSnapshot[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([slug])
  @@index([isActive])
}

model WorkerService {
  id                String          @id @default(uuid())
  workerProfileId   String
  workerProfile     WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)

  customHourlyRate  Decimal?        @db.Decimal(10, 2)
  isCertified       Boolean         @default(false)
  isActive          Boolean         @default(true)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workerProfileId, serviceCategoryId])
  @@index([serviceCategoryId, isActive])
}

/// Professional certifications, licenses, and verified trade diplomas.
/// Upload via Document Vault → creates a row here → renders badge without redeploy.
model Certification {
  id                 String             @id @default(uuid())
  workerProfileId    String
  workerProfile      WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  title              String
  issuingAuthority   String             // e.g. "NCCT", "Skill India", "State Board"
  skill              String?            // e.g. "Wireman", "Plumbing"
  grade              String?            // e.g. "A", "B", "Distinction"
  licenseNumber      String?
  documentUrl        String?            // Supabase Storage public URL
  badgeSvgId         String?            // Reference to a badge design ID
  issueDate          DateTime?
  expiresAt          DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([workerProfileId])
  @@index([verificationStatus])
}

// ----------------------------------------------------------------------------
// AVAILABILITY WINDOWS
// ----------------------------------------------------------------------------

/// Worker declares when they can accept bookings. Dispatch only inside windows.
model AvailabilityWindow {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  dayOfWeek       Int           // 0=Sun, 1=Mon ... 6=Sat
  startHour       Int           // 0-23
  endHour         Int           // 0-23
  timezone        String        @default("Asia/Kolkata")
  isActive        Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workerProfileId, dayOfWeek])
  @@index([isActive])
}

// ----------------------------------------------------------------------------
// BOOKINGS
// ----------------------------------------------------------------------------

/// Represents a customer service engagement with a cooperative worker-member.
model Booking {
  id                     String          @id @default(uuid())
  bookingNumber          String          @unique  // Human-friendly: "BKG-2026-0001"

  customerId             String
  customer               User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)

  workerId               String
  worker                 WorkerProfile   @relation("WorkerBookings", fields: [workerId], references: [id], onDelete: Restrict)

  serviceCategoryId      String
  serviceCategory        ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)

  // Booking Type & Scheduling
  bookingType            BookingType     @default(INSTANT)
  recurrenceRule         String?         // iCal RRULE or null for one-time
  status                 BookingStatus   @default(PENDING)
  scheduledDate          DateTime
  estimatedDurationHours Decimal?        @db.Decimal(4, 2)
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?         @db.Text

  // Emergency Dispatch
  isEmergency            Boolean         @default(false)
  surgeMultiplier        Decimal         @default(1.00) @db.Decimal(4, 2)  // e.g. 1.50 = 50% surge

  // Service Location
  serviceAddressLine1    String
  serviceAddressLine2    String?
  serviceCity            String
  servicePostalCode      String
  serviceLatitude        Float
  serviceLongitude       Float
  locationInstructions   String?         @db.Text

  // Financial Summary
  baseAmount             Decimal         @db.Decimal(10, 2)  // Pre-surge amount
  surgeAmount            Decimal         @default(0.00) @db.Decimal(10, 2)  // Surge delta only
  totalAmount            Decimal         @db.Decimal(10, 2)  // baseAmount + surgeAmount
  currency               String          @default("INR")

  payment                Payment?
  review                 Review?
  disputes               Dispute[]

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([customerId, status])
  @@index([workerId, status])
  @@index([workerId, scheduledDate])
  @@index([status, scheduledDate])
  @@index([serviceCategoryId, status])
  @@index([serviceLatitude, serviceLongitude])
  @@index([createdAt])
  @@index([isEmergency])
}

// ----------------------------------------------------------------------------
// PAYMENTS & 90/5/5 SPLIT LEDGER
// ----------------------------------------------------------------------------

/// Payment record with cooperative patronage split tracking.
/// Emergency surge: workerShare = 90% of base + 100% of surge delta.
model Payment {
  id                   String          @id @default(uuid())
  transactionId        String          @unique  // Gateway reference (e.g. UPI UTR)

  bookingId            String          @unique
  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  societyId            String?
  society              Society?        @relation(fields: [societyId], references: [id], onDelete: SetNull)

  // Base split (90/5/5 of baseAmount)
  baseAmount           Decimal         @db.Decimal(10, 2)
  surgeAmount          Decimal         @default(0.00) @db.Decimal(10, 2)  // 100% goes to worker
  totalAmount          Decimal         @db.Decimal(10, 2)

  // Split amounts (in paise-equivalent integer arithmetic via app layer)
  workerAmount         Decimal         @db.Decimal(10, 2)  // 90% base + 100% surge
  societyAmount        Decimal         @db.Decimal(10, 2)  // 5% of base
  welfareAmount        Decimal         @db.Decimal(10, 2)  // 5% of base (remainder)
  guaranteeFundAmount  Decimal         @default(0.00) @db.Decimal(10, 2)

  // Applied ratios (stored for auditability)
  workerSplitRatio     Decimal         @default(0.9000) @db.Decimal(5, 4)
  societySplitRatio    Decimal         @default(0.0500) @db.Decimal(5, 4)
  welfareSplitRatio    Decimal         @default(0.0500) @db.Decimal(5, 4)

  gatewayFeeAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  currency             String          @default("INR")

  paymentMethod        PaymentMethod   @default(UPI)
  status               PaymentStatus   @default(PENDING)
  gatewayProvider      String          @default("MOCK_UPI")  // "MOCK_UPI" | "NPCI_BHIM" | etc.

  // Escrow & Settlement Milestones
  escrowHeldAt         DateTime?
  escrowReleasedAt     DateTime?
  workerPaidOutAt      DateTime?
  refundedAt           DateTime?

  // Audit Trail
  gatewayRawResponse   Json?
  failureReason        String?         @db.Text
  ledgerEntries        WalletLedger[]

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([societyId, status])
  @@index([transactionId])
  @@index([bookingId])
}

// ----------------------------------------------------------------------------
// WALLETS & WELFARE LEDGER
// ----------------------------------------------------------------------------

/// Digital wallets for Worker Members, Society Reserve, Welfare Trust, Guarantee Fund.
model Wallet {
  id            String         @id @default(uuid())
  type          WalletType
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  societyId     String?
  society       Society?       @relation(fields: [societyId], references: [id], onDelete: SetNull)
  balance       Decimal        @default(0.00) @db.Decimal(14, 2)
  currency      String         @default("INR")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ledgerEntries WalletLedger[]

  @@unique([userId, type])
  @@unique([societyId, type])
  @@index([type])
  @@index([societyId])
}

/// Double-entry ledger — every credit/debit is recorded here.
/// Welfare corpus = SUM(amount) WHERE walletId IN welfare_wallet_ids
model WalletLedger {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(14, 2)
  entryType   String   // "CREDIT" | "DEBIT"
  description String
  balanceAfter Decimal @db.Decimal(14, 2)  // Running balance snapshot
  createdAt   DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([paymentId])
}

// ----------------------------------------------------------------------------
// REPUTATION & REVIEWS
// ----------------------------------------------------------------------------

/// Verified reviews tied strictly to completed bookings (1-to-1).
model Review {
  id                   String          @id @default(uuid())
  bookingId            String          @unique
  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  customerId           String
  customer             User            @relation("AuthoredReviews", fields: [customerId], references: [id], onDelete: Restrict)

  workerId             String
  worker               WorkerProfile   @relation("WorkerReceivedReviews", fields: [workerId], references: [id], onDelete: Restrict)

  // Numerical Evaluation (1–5 stars)
  rating               Int             // Overall; validated 1-5 at app layer
  punctualityRating    Int?
  qualityRating        Int?
  valueRating          Int?

  comment              String?         @db.Text
  workerReply          String?         @db.Text
  workerRepliedAt      DateTime?

  // Low-rating auto-dispute trigger (<= 3 stars creates a Dispute row)
  triggeredDisputeId   String?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([workerId, rating])
  @@index([customerId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// DISPUTE RESOLUTION — PEER ARBITRATION
// ----------------------------------------------------------------------------

/// Cooperative peer-arbitrated dispute. Full state machine:
/// OPEN → PEER_REVIEW → RESOLVED_UPHELD | RESOLVED_OVERTURNED → CLOSED
model Dispute {
  id                   String              @id @default(uuid())
  bookingId            String
  booking              Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  raisedById           String
  raisedBy             User                @relation("DisputesRaisedByUser", fields: [raisedById], references: [id], onDelete: Restrict)

  reason               String
  description          String              @db.Text
  customerStatement    String?             @db.Text
  workerDefenseStatement String?           @db.Text

  status               DisputeStatus       @default(OPEN)
  resolutionNotes      String?             @db.Text
  resolvedAt           DateTime?

  // Peer council (3 members per cooperative charter)
  councilVotes         PeerCouncilVote[]

  // Financial remedy (paid from guarantee fund if upheld)
  remedyAmount         Decimal?            @db.Decimal(10, 2)
  remedyPaidAt         DateTime?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

/// Individual peer council member vote on a dispute. 3 votes → auto-resolve.
model PeerCouncilVote {
  id         String              @id @default(uuid())
  disputeId  String
  dispute    Dispute             @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  voterId    String
  voter      User                @relation(fields: [voterId], references: [id], onDelete: Restrict)

  decision   DisputeVoteDecision
  rationale  String?             @db.Text
  votedAt    DateTime            @default(now())

  @@unique([disputeId, voterId])   // One vote per council member per dispute
  @@index([disputeId])
}

// ----------------------------------------------------------------------------
// TOOL INVENTORY & COOPERATIVE ASSET MANAGEMENT
// ----------------------------------------------------------------------------

model ToolInventory {
  id                  String         @id @default(uuid())
  name                String
  category            String
  serialNumber        String         @unique
  condition           ToolCondition  @default(GOOD)
  dailyFee            Decimal        @db.Decimal(8, 2)
  isAvailable         Boolean        @default(true)
  societyId           String?
  purchaseDate        DateTime?
  lastMaintenanceDate DateTime?
  notes               String?        @db.Text

  checkouts           ToolCheckout[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([societyId, isAvailable])
  @@index([category])
}

model ToolCheckout {
  id              String        @id @default(uuid())
  toolId          String
  tool            ToolInventory @relation(fields: [toolId], references: [id], onDelete: Restrict)

  workerProfileId String
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)

  checkedOutAt    DateTime      @default(now())
  expectedReturn  DateTime?
  returnedAt      DateTime?
  feePaid         Decimal?      @db.Decimal(8, 2)

  @@index([toolId])
  @@index([workerProfileId])
}

// ----------------------------------------------------------------------------
// DEMAND SNAPSHOTS (for AI forecasting with real data)
// ----------------------------------------------------------------------------

/// Periodic demand snapshots for trend analysis. Populated from booking aggregates.
model DemandSnapshot {
  id                String          @id @default(uuid())
  snapshotDate      DateTime        @db.Date
  societyId         String?
  society           Society?        @relation(fields: [societyId], references: [id], onDelete: SetNull)
  serviceCategoryId String?
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  areaPostalCode    String?
  bookingCount      Int             @default(0)
  completedCount    Int             @default(0)
  totalRevenue      Decimal         @default(0.00) @db.Decimal(14, 2)
  activeWorkerCount Int             @default(0)

  createdAt         DateTime        @default(now())

  @@unique([snapshotDate, societyId, serviceCategoryId, areaPostalCode])
  @@index([snapshotDate])
  @@index([societyId])
  @@index([serviceCategoryId])
}

// ----------------------------------------------------------------------------
// EVENT OUTBOX (pragmatic substitute for Kafka)
// Implements reliable event-driven decoupling via DB outbox pattern.
// Swappable for Kafka at scale — see docs/architecture.md.
// ----------------------------------------------------------------------------

model EventOutbox {
  id          String        @id @default(uuid())
  topic       String        // e.g. "booking.created", "payment.released", "dispute.opened"
  payload     Json
  status      OutboxStatus  @default(PENDING)
  publishedAt DateTime?
  failureReason String?     @db.Text
  retries     Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([topic])
}
